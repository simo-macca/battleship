    <!-- #custom PF2 rules -->
    <rule name="Null usage"
          language="java"
          message="Use Option instead of null"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Use the jtamaro.en.Option class to model values that may
            or may not have a value.
        </description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//NullLiteral
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="Instanceof usage"
          language="java"
          message="Do not use instanceof"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            As we have seen in class, the usage of instanceof is considered
            an anti-pattern in object-oriented programming.  It&apos;s almost
            always possible to write your code in such a way that does
            not require you to use instanceof and casts
        </description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//InfixExpression[@Operator="instanceof"]
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="Cast usage"
          language="java"
          message="Do not use casting operator"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            As we have seen in class, the usage of casting is considered
            an anti-pattern in object-oriented programming.  It&apos;s almost
            always possible to write your code in such a way that does
            not require you to use instanceof and casts
        </description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//CastExpression
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="Non-final field"
          language="java"
          message="Avoid non-final fields"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Non-final fields allow for global mutation, which is not
            allowed per the project requirement (unless strictly necessary).
        </description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//FieldDeclaration[not(pmd-java:modifiers() = 'final')]
]]>
                </value>
            </property>
        </properties>
    </rule>
    <!-- #end custom PF2 -->
